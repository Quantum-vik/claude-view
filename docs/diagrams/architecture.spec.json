  "cards": [
    {
      "dot": "emerald",
      "title": "Three layers, three latencies",
      "items": [
        "PTY bytes \u2192 WebSocket \u2192 xterm.js: instant, char-by-char",
        "Transcript tailed from disk: ~0.2 s behind the event",
        "Hooks over authenticated localhost HTTP: per-event"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why the transcript owns the record",
      "items": [
        "It is the only source that sees a subagent's work at all",
        "No channel streams tool output while a command still runs",
        "Nothing is cached: the largest real transcript parses in 46 ms"
      ]
    },
    {
      "dot": "rose",
      "title": "The trust boundary",
      "items": [
        "The token is never an env var \u2014 every child would inherit it",
        "Discovery files are 0600 via O_EXCL + fsync + rename",
        "pty: Option<Pty> \u2014 watched means read-only by construction"
      ]
    }
  ]
