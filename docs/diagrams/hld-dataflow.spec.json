  "cards": [
    {
      "dot": "emerald",
      "title": "Why three paths and not one",
      "items": [
        "No channel streams tool output while a command is still running",
        "So the mirror owns the terminal \u2014 bytes, never parsed",
        "The transcript is the only source that sees a subagent at all"
      ]
    },
    {
      "dot": "cyan",
      "title": "The fold is the whole cost story",
      "items": [
        "One record per content block, each repeating the same usage",
        "A resumed session replays earlier turns into a new file",
        "One global last-wins fold on requestId answers both"
      ]
    }
  ]
