  "cards": [
    {
      "dot": "cyan",
      "title": "Attribution happens once",
      "items": [
        "transcript::locate matches on the file's own cwd, gated on start time",
        "Without that gate a private session in the same directory would leak",
        "trace::locate_for is a one-line delegation to it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Same files, different questions",
      "items": [
        "trace is positional and paged; the roster is whole-session",
        "rollup is whole-machine and folds across files",
        "liveness reads only the last 400 KB and no timestamps"
      ]
    },
    {
      "dot": "amber",
      "title": "Why two leaves",
      "items": [
        "changes.rs takes only Path, Command and Serialize",
        "git.rs takes only std::path \u2014 it walks .git by hand",
        "Everything they answer derives from a path and a timestamp"
      ]
    }
  ]
