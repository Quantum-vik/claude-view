{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for all claude-view windows",
  "windows": ["main", "session-*", "agent-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "dialog:default"
  ]
}
